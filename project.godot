;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sheeple Pleaser"
run/main_scene="uid://dr0r8wtcjytkg"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://Assets/Visual/Miscellaneous/icon.svg"

[autoload]

Math="*uid://cysqowd86ofjb"
Events="*uid://8u4phpbpfi31"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/stretch/mode="viewport"
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_super-wakatime/plugin.cfg")

[global_group]

